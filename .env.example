# ---- Web (apps/web) ----
# Data mode: "mock" (Phase 1, local JSON) or "http" (Phase 2, real API)
VITE_DATA_MODE=mock
VITE_API_BASE_URL=http://localhost:3001/api

# ---- API (apps/api) ----
PORT=3001
# Data backend: "memory" (dev/tests, seeded fixtures) or "pg" (PostgreSQL)
DATA_BACKEND=memory
# PostgreSQL connection (Phase 2 only)
DATABASE_URL=postgres://incident:incident@localhost:5432/incident

# Auth — REQUIRED in real runs. Never commit a real secret.
JWT_SECRET=change-me-in-your-local-env
JWT_EXPIRES_IN=8h

# AI provider: "rules" (default, no external dep) or "bedrock"
AI_PROVIDER=rules
# Only used when AI_PROVIDER=bedrock. Read from env/secret store, never commit.
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=
API_KEY=

# Logging
LOG_LEVEL=info
